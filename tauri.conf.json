{
  "$schema": "https://schema.tauri.app/config/2.0",
  "identifier": "com.aiassistant.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "productName": "AI Assistant",
    "version": "0.1.0",
    "windows": [
      {
        "title": "AI Assistant",
        "width": 800,
        "height": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "allowlist": {
    "all": false,
    "shell": {
      "execute": true,
      "scope": ["**"]
    },
    "dialog": {
      "all": true
    },
    "fs": {
      "all": true,
      "scope": ["**"]
    }
  }
}